{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idolytics",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "idolytics",
      // Paste the id printed by `npx wrangler d1 create idolytics`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
  // ADMIN_KEY is a secret: `npx wrangler secret put ADMIN_KEY`, and `.dev.vars` locally.
}
